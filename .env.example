# Copy this file to .env before running `docker compose up`.
#
# Both variables are required: docker-compose.yml refuses to start db/api/mcp
# without them (the ${VAR:?message} syntax below), rather than silently
# falling back to a guessable default in a file meant to be copied as-is.

# The db service's own credential -- never used by anything outside this
# compose stack.
POSTGRES_PASSWORD=change-me

# Required on every REST/MCP route except /api/health -- see memgit.keyauth.
# api and mcp bind 0.0.0.0 inside the compose network, which is exactly the
# non-loopback case that key is required for. Generate one with:
#   py -m uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
MEMGIT_API_KEY=change-me
